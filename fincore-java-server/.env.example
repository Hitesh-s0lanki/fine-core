DATABASE_URL=jdbc:postgresql://localhost:5432/fincore
DATABASE_USERNAME=fincore
DATABASE_PASSWORD=fincore
POSTGRES_PORT=5432

# Optional: schedule configured ingestion targets (manual refresh works without this).
INGESTION_SCHEDULING_ENABLED=false
INGESTION_SCHEDULING_SCAN_MS=30000

# Required for SEC company discovery: application name plus your real contact email.
SEC_USER_AGENT=
# Persist this local directory with the Java service; raw evidence is referenced by file URI.
SEC_RAW_DIRECTORY=./data/sec-directory
