FINECORE_APP_NAME=finecore-ai-server
FINECORE_ENVIRONMENT=development

# Optional: override the local temp/ registry with a persistent storage directory.
# FINECORE_ADAPTER_REGISTRY_DIR=/absolute/path/to/adapter-registry

# Run the worker separately: uv run python -m services.ingestion_worker
FINECORE_CORE_API_URL=http://127.0.0.1:8080
# JSON list of explicitly approved source origins, including non-default ports.
FINECORE_INGESTION_ALLOWED_ORIGINS=[]
# Retain this directory on persistent storage; file URIs are local to the worker host.
# FINECORE_INGESTION_RAW_DIR=/absolute/path/to/ingestion-raw
FINECORE_INGESTION_USER_AGENT=FinCore-local-ingestion/0.1
FINECORE_INGESTION_MAX_BYTES=5000000
FINECORE_INGESTION_POLL_SECONDS=5
